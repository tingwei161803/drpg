# Copy to .env and fill in the providers you actually use, then `source .env`.
# Every backend reads its key from the environment; nothing is stored in configs.

# Google AI Studio -- series: gemini_dev (gemini-2.0-flash, gemini-2.0-flash-lite)
export GOOGLE_API_KEY=

# NVIDIA NIM -- series: nvidia (llama-3.3-70b, llama-4-*, mistral-*)
export NVIDIA_API_KEY=

# Optional backends
# export OAI_KEY=            # series: openai
# export CUSTOM_API_URL=     # series: openai, for an OpenAI-compatible endpoint
# export ANTHROPIC_KEY=      # series: anthropic
# export GCP_API_KEY=        # series: gemini_new (Gemini REST API)
# export LLAMA_API_KEY=      # series: llama (Meta Llama API)
# export MISTRAL_API_KEY=    # series: mistral
# export TOGETHER_API_KEY=   # series: together
# export GROQ_API_KEY=       # series: groq_model
# export NEBIUS_API_KEY=     # series: nebius
# export XAI_API_KEY=        # series: xai
# series: ollama talks to http://localhost:11434 and needs no key.

# Optional: Weights & Biases logging (only used with --use_wandb)
# export WANDB_ENTITY=
